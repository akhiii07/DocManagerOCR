# ---------------------------------------------------------------------------
# CUSTOMER DATA - NEVER COMMIT
# These patterns are a safety net, not a policy. The policy is: real customer
# documents live outside the repo entirely. See docs/privacy/data-handling-policy.md
# ---------------------------------------------------------------------------
corpus/
documents/
samples/real/
*.pdf
*.tif
*.tiff
*.jpg
*.jpeg
*.png
!docs/**/*.png

# Exception: PUBLIC regulatory instruments are kept in the repo deliberately, so that
# every citation in requirements.yaml resolves to the exact text it was read from.
# These are government publications with no privacy sensitivity. Customer documents
# remain blocked by the patterns above.
!docs/regulatory/sources/*.pdf
!docs/regulatory/sources/*.PDF

# Survey output can contain filenames; filenames can contain customer names.
survey-output/
*.survey.json

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# ---------------------------------------------------------------------------
# Local machine state
# ---------------------------------------------------------------------------
.claude/settings.local.json
fixtures/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
Thumbs.db
desktop.ini


# Evaluation output - may contain values when --show-names/--show-values is used
eval-output/
eval/groundtruth/real/
